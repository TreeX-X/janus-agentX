{
  "name": "@janus-agent/harness-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared harness data logic for WorkflowX notes: parse, schema, graph, hash, lifecycle, task state, receipt, changeset. No fs, no Electron, no agent loop, no LLM.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-dist-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
