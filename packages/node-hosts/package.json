{
  "name": "@janus-agent/node-hosts",
  "version": "0.1.0",
  "type": "module",
  "description": "Pure-Node host implementations of command.run, git.* and background job tools over @janus-agent/agent-core. No Electron dependency. Shared by the janus CLI and (later) the JanusX shell.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-dist-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@janus-agent/agent-core": "file:../agent-core"
  }
}
