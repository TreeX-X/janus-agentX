{
  "name": "@janus-agent/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone janus CLI - headless agent runs over @janus-agent/agent-core. No Electron, no node-pty.",
  "bin": {
    "janus": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-dist-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@janus-agent/agent-core": "file:../agent-core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
