{
  "name": "@janus-agent/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone janus CLI - dialogue/tool-call turns over @janus-agent/janus-agent with a local runtime. No Electron, no subprocess runner.",
  "bin": {
    "janus": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-dist-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@janus-agent/agent-core": "file:../agent-core",
    "@janus-agent/janus-agent": "file:../janus-agent",
    "@janus-agent/node-hosts": "file:../node-hosts",
    "ai": "3.4.33",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
