{
  "name": "janus-agentx",
  "version": "0.1.0",
  "private": true,
  "description": "Janus agent engine extracted from JanusX - agent loop, runtime, LLM orchestration helpers and workspace tools, with standalone janus CLI.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "update:model-limits": "node scripts/update-model-limits.mjs",
    "pack:cli": "npm run build && node scripts/pack-cli.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.63.1"
  }
}
